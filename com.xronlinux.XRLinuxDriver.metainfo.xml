  <project_license>GPL-3.0-or-later AND LicenseRef-proprietary</project_license>
  <url type="homepage">https://github.com/wheaney/XRLinuxDriver</url>
  <url type="bugtracker">https://github.com/wheaney/XRLinuxDriver/issues</url>
